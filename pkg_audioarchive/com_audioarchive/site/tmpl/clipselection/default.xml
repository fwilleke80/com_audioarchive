<?xml version="1.0" encoding="UTF-8"?>
<metadata>
    <layout title="COM_AUDIOARCHIVE_MENU_CLIP_TITLE" option="COM_AUDIOARCHIVE_MENU_CLIP_TITLE">
        <message>COM_AUDIOARCHIVE_MENU_CLIP_DESC</message>
    </layout>
    <fields name="params">
        <fieldset name="basic" label="COM_AUDIOARCHIVE_MENU_CLIP_SELECTION">
            <field name="clip_selection_mode" type="list" default="specific" label="COM_AUDIOARCHIVE_MENU_CLIP_SELECTION">
                <option value="specific">COM_AUDIOARCHIVE_MENU_CLIP_SPECIFIC</option>
                <option value="latest">COM_AUDIOARCHIVE_MENU_CLIP_LATEST</option>
                <option value="random">COM_AUDIOARCHIVE_MENU_CLIP_RANDOM</option>
                <option value="daily">COM_AUDIOARCHIVE_MENU_CLIP_DAILY</option>
            </field>
            <field name="specific_clip" type="sql" query="SELECT id AS value, title AS text FROM #__audioarchive_clips WHERE state = 1 ORDER BY title" key_field="value" value_field="text" label="COM_AUDIOARCHIVE_MENU_CLIP_SPECIFIC" showon="clip_selection_mode:specific" />
            <field name="clip_alias" type="text" label="COM_AUDIOARCHIVE_MENU_CLIP_ALIAS" description="COM_AUDIOARCHIVE_MENU_CLIP_ALIAS_DESC" showon="clip_selection_mode:specific" />
            <field name="latest_date" type="list" default="uploaded" label="COM_AUDIOARCHIVE_MENU_CLIP_LATEST_DATE" showon="clip_selection_mode:latest">
                <option value="uploaded">COM_AUDIOARCHIVE_MENU_CLIP_DATE_UPLOADED</option>
                <option value="recorded">COM_AUDIOARCHIVE_MENU_CLIP_DATE_RECORDED</option>
                <option value="published">JPUBLISHED</option>
            </field>
            <field name="categories" type="category" extension="com_audioarchive" multiple="true" label="JCATEGORIES" />
            <field name="tags" type="tag" multiple="true" custom="deny" label="JTAG" />
            <field name="tag_mode" type="list" default="all" label="COM_AUDIOARCHIVE_MENU_CLIP_TAG_MODE">
                <option value="all">COM_AUDIOARCHIVE_MENU_CLIP_TAG_ALL</option>
                <option value="any">COM_AUDIOARCHIVE_MENU_CLIP_TAG_ANY</option>
            </field>
            <field name="detail_presentation" type="list" default="" label="COM_AUDIOARCHIVE_MENU_CLIP_PRESENTATION">
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="minimal">COM_AUDIOARCHIVE_MENU_CLIP_MINIMAL</option>
                <option value="compact">COM_AUDIOARCHIVE_MENU_CLIP_COMPACT</option>
                <option value="default">JDEFAULT</option>
                <option value="featured">COM_AUDIOARCHIVE_MENU_CLIP_FEATURED</option>
            </field>
        </fieldset>
    </fields>
</metadata>
