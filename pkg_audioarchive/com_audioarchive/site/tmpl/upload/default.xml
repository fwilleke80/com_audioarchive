<?xml version="1.0" encoding="UTF-8"?>
<metadata><layout title="COM_AUDIOARCHIVE_FRONTEND_UPLOAD"><message>COM_AUDIOARCHIVE_FRONTEND_UPLOAD_DESC</message></layout><fields name="params"><fieldset name="basic" label="JGLOBAL_FIELDSET_BASIC">
<field name="upload_intro" type="editor" label="COM_AUDIOARCHIVE_MENU_INTRO_TEXT_LABEL" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
<field name="upload_category_mode" type="list" label="COM_AUDIOARCHIVE_UPLOAD_CATEGORY_MODE" default="choose"><option value="choose">COM_AUDIOARCHIVE_UPLOAD_CATEGORY_CHOOSE</option><option value="fixed">COM_AUDIOARCHIVE_UPLOAD_CATEGORY_FIXED</option></field>
<field name="upload_fixed_category" type="category" extension="com_audioarchive" published="1" label="JCATEGORY" showon="upload_category_mode:fixed" />
<field name="upload_allowed_categories" type="category" extension="com_audioarchive" published="1" multiple="true" label="COM_AUDIOARCHIVE_UPLOAD_ALLOWED_CATEGORIES" />
<field name="upload_default_visibility" type="list" label="COM_AUDIOARCHIVE_UPLOAD_DEFAULT_VISIBILITY" default="normal"><option value="normal">COM_AUDIOARCHIVE_VISIBILITY_NORMAL</option><option value="registered">COM_AUDIOARCHIVE_VISIBILITY_REGISTERED</option><option value="private">COM_AUDIOARCHIVE_VISIBILITY_PRIVATE</option></field>
