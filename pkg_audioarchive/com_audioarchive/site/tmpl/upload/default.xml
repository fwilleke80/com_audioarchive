<field name="upload_redirect" type="list" label="COM_AUDIOARCHIVE_UPLOAD_REDIRECT" default="myclips"><option value="myclips">COM_AUDIOARCHIVE_MY_CLIPS</option><option value="clip">COM_AUDIOARCHIVE_UPLOAD_REDIRECT_CLIP</option><option value="upload">COM_AUDIOARCHIVE_UPLOAD_REDIRECT_STAY</option></field>
</fieldset></fields></metadata>
