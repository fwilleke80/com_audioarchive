<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details" label="COM_AUDIOARCHIVE_FIELDSET_DETAILS">
		<field name="id" type="hidden" />
		<field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" maxlength="400" hint="JFIELD_ALIAS_PLACEHOLDER" />
		<field
			name="catid"
			type="category"
			extension="com_audioarchive"
			published="0,1"
			label="JCATEGORY"
			required="true"
		>
			<option value="">JOPTION_SELECT_CATEGORY</option>
		</field>
		<field name="tags" type="tag" label="JTAG" multiple="true" mode="ajax" custom="deny" />
		<field name="description" type="editor" label="JGLOBAL_DESCRIPTION" buttons="true" hide="fields" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		<field name="recorded_at" type="calendar" label="COM_AUDIOARCHIVE_FIELD_RECORDING_DATE" translateformat="true" showtime="true" filter="user_utc" />
	<field name="allow_embed" type="radio" layout="joomla.form.field.radio.switcher" label="COM_AUDIOARCHIVE_ALLOW_EMBED" description="COM_AUDIOARCHIVE_ALLOW_EMBED_DESC" default="1" filter="integer" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="normalization_mode" type="list" label="COM_AUDIOARCHIVE_NORMALIZATION_MODE" description="COM_AUDIOARCHIVE_NORMALIZATION_HELP" default="inherit" validate="options"><option value="inherit">COM_AUDIOARCHIVE_NORMALIZATION_INHERIT</option><option value="enabled">JENABLED</option><option value="disabled">JDISABLED</option></field>
</fieldset>
	<fieldset name="publishing" label="COM_AUDIOARCHIVE_FIELDSET_PUBLISHING"><field name="visibility_mode" type="list" label="COM_AUDIOARCHIVE_VISIBILITY"><option value="public">COM_AUDIOARCHIVE_VISIBILITY_NORMAL</option><option value="registered">COM_AUDIOARCHIVE_VISIBILITY_REGISTERED</option><option value="private">COM_AUDIOARCHIVE_VISIBILITY_PRIVATE</option></field>
		<field name="state" type="list" label="JSTATUS" default="0" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" default="1" />
		<field name="publish_up" type="calendar" label="JGLOBAL_FIELD_PUBLISH_UP_LABEL" translateformat="true" showtime="true" filter="user_utc" />
		<field name="publish_down" type="calendar" label="JGLOBAL_FIELD_PUBLISH_DOWN_LABEL" translateformat="true" showtime="true" filter="user_utc" />
	</fieldset>
    <fieldset name="metadata" label="COM_AUDIOARCHIVE_METADATA">
        <field name="licence" type="text" label="COM_AUDIOARCHIVE_METADATA_LICENCE" description="COM_AUDIOARCHIVE_METADATA_LICENCE_DESC" maxlength="255" filter="string" />
        <field name="creator" type="text" label="COM_AUDIOARCHIVE_METADATA_CREATOR" description="COM_AUDIOARCHIVE_METADATA_CREATOR_DESC" maxlength="255" filter="string" />
        <field name="contributors" type="textarea" label="COM_AUDIOARCHIVE_METADATA_CONTRIBUTORS" description="COM_AUDIOARCHIVE_METADATA_CONTRIBUTORS_DESC" maxlength="8000" filter="string" rows="4" />
        <field name="recording_location" type="text" label="COM_AUDIOARCHIVE_METADATA_RECORDING_LOCATION" description="COM_AUDIOARCHIVE_METADATA_RECORDING_LOCATION_DESC" maxlength="255" filter="string" />
        <field name="genre_style" type="text" label="COM_AUDIOARCHIVE_METADATA_GENRE_STYLE" description="COM_AUDIOARCHIVE_METADATA_GENRE_STYLE_DESC" maxlength="255" filter="string" />
        <field name="creation_year" type="number" label="COM_AUDIOARCHIVE_METADATA_CREATION_YEAR" description="COM_AUDIOARCHIVE_METADATA_CREATION_YEAR_DESC" min="1" max="9999" step="1" filter="string" />
        <field name="lyrics" type="textarea" label="COM_AUDIOARCHIVE_METADATA_LYRICS" description="COM_AUDIOARCHIVE_METADATA_LYRICS_DESC" maxlength="60000" filter="string" rows="8" />
    </fieldset>
</form>
